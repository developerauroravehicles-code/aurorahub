{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/send-reminders", "schedule": "0 * * * *" },
    { "path": "/api/send-scheduled-reports", "schedule": "0 * * * *" },
    { "path": "/api/check-low-stock", "schedule": "0 9 * * *" },
    { "path": "/api/inventory-stock-notify", "schedule": "0 9,15 * * *" },
    { "path": "/api/run-alerts", "schedule": "*/15 * * * *" },
    { "path": "/api/daily-invoice-review-notify", "schedule": "0 * * * *" },
    { "path": "/api/daily-invoice-auto-send", "schedule": "30 * * * *" },
    { "path": "/api/daily-invoice-eod-notify", "schedule": "0 * * * *" }
  ]
}
